# ─── API Authentication ──────────────────────────────────────────────────────
# Shared secret between main backend and this email service.
# Generate one: openssl rand -hex 32
EMAIL_API_KEY=

# ─── Gmail SMTP Credentials ─────────────────────────────────────────────────
# Generate app password: Google Account > Security > 2-Step Verification > App passwords
GMAIL_USER=
GMAIL_APP_PASS=
